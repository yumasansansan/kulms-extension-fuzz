#
# What the Site Info page of a course shows around its contact, which
# fetchSakaiSiteContact() looks for with a regular expression; the fuzzer
# cannot learn what a regular expression compares, so it is told.

# サイト連絡先・メール
"\xe3\x82\xb5\xe3\x82\xa4\xe3\x83\x88\xe9\x80\xa3\xe7\xb5\xa1\xe5\x85\x88\xe3\x83\xbb\xe3\x83\xa1\xe3\x83\xbc\xe3\x83\xab"
# サイト連絡先
"\xe3\x82\xb5\xe3\x82\xa4\xe3\x83\x88\xe9\x80\xa3\xe7\xb5\xa1\xe5\x85\x88"
# メール
"\xe3\x83\xa1\xe3\x83\xbc\xe3\x83\xab"
# ・
"\xe3\x83\xbb"
# ･
"\xef\xbd\xa5"
# <td>
"<td>"
# <td class=\"x\">
"<td class=\x22x\x22>"
# </td>
"</td>"
# <th>
"<th>"
# </th>
"</th>"
# ,
","
# <
"<"
# >
">"
# <a href=\"mailto:
"<a href=\x22mailto:"
# \n
"\x0a"
# \t
"\x09"
#  
" "
# 　
"\xe3\x80\x80"
